{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bantani-web-test",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "secrets": {
    "required": [
      "BASIC_AUTH_USERNAME",
      "BASIC_AUTH_PASSWORD"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
